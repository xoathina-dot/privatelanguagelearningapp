# Copy this file to .env for local development.
# On Replit, set these as "Secrets" instead of committing a .env file.

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-string

# --- AI (tutor chat, translation, grammar correction) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model used for AI features (default: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# --- The two accounts (set these before first run) ---
# ROLE: "learner" (does lessons/quiz/vocab themselves) or "companion"
#       (no own lessons/quiz — sees the partner's progress instead and gets
#       a support-coach AI tutor rather than a language tutor)
# TARGET_LANG / NATIVE_LANG: "de" (German) or "el" (Greek).
#   - learner: TARGET_LANG is the language they're learning, NATIVE_LANG their native one.
#   - companion: TARGET_LANG should match the partner's TARGET_LANG (what the partner
#     is learning, used for the read-only dashboard + vocab reference);
#     NATIVE_LANG is the companion's own native language.

USER1_USERNAME=
USER1_PASSWORD=
USER1_DISPLAY_NAME=
USER1_ROLE=companion
USER1_TARGET_LANG=de
USER1_NATIVE_LANG=el

USER2_USERNAME=
USER2_PASSWORD=
USER2_DISPLAY_NAME=
USER2_ROLE=learner
USER2_TARGET_LANG=de
USER2_NATIVE_LANG=el

# --- Server ---
PORT=3000

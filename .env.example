# Copy this file to .env for local development.
# On Replit, set these as "Secrets" instead of committing a .env file.

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-string

# --- AI (tutor chat, translation, grammar correction) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model used for AI features (default: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# --- The two accounts (set these before first run, then you can remove them) ---
USER1_USERNAME=
USER1_PASSWORD=
USER1_DISPLAY_NAME=
# "de" = learning German (native Greek) · "el" = learning Greek (native German)
USER1_TARGET_LANG=de

USER2_USERNAME=
USER2_PASSWORD=
USER2_DISPLAY_NAME=
USER2_TARGET_LANG=el

# --- Server ---
PORT=3000
